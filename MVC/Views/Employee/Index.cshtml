@model List<Employee>

@{
	ViewData["Title"] = "Index";
    Layout = "_AdvLayout";
}

<h1>Index</h1>

<a asp-action="New" asp-controller="Employee">New</a>

<hr />

<table class="table table-hover table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Salary</th>
        <th></th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Salary</td>
            <td><a href="/Employee/Edit/@item.Id">Edit</a></td>
        </tr>
    }
</table>