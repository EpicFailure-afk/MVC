@model EmpWithDeptListViewModel

@{
	ViewData["title"] = "Edit";
}

<h1>Edit</h1>

<form method="post" asp-action="SaveEdit" asp-route-id="@Model.Id"/>   @*action="/Employee/SaveEdit/@Model.Id">*@
	<div>
		<lable>Name</lable>
		@* <input type="text" value="@Model.Name" id="Name" name="Name" class="form-check form-control" /> *@
		
		@Html.LabelFor(e => e.Name)
		@Html.EditorFor(e => e.Name)
		@*diff between LabelFor and EditorFor: EditorFor decides which type is better*@

		@*Mix-server-side-attr*@
		<label asp-for="Name"></label>
		<input class="form form-control" asp-for="Name" />

		@Html.TextBox("Name")  @*Lossly type helper*@
		@Html.TextBoxFor(e => e.Name, new { style = "color:red", @class = "form-check form-control" }) @*strong type helper*@
		
	</div>

	<div>
		<lable>Address</lable>
		<input type="text" value="@Model.Address" id="Address" name="Address" class="form-check form-control" />
	</div>

	<div>
		<lable>ImageUrl</lable>
		<input type="text" value="@Model.ImageUrl" id="ImageUrl" name="ImageUrl" class="form-check form-control" />
	</div>

	<div>
		<lable>Salary</lable>
		<input type="number" value="@Model.Salary" id="Salary" name="Salary" class="form-check form-control" />
	</div>

	<div>
		<lable>JobTitle</lable>
		<input type="text" value="@Model.JobTitle" id="JobTitle" name="JobTitle" class="form-check form-control" />
	</div>

	<div>
		<lable>DepartmentID</lable>
		@* <input type="text" value="@Model.DeptID" id="DeptID" name="DeptID" class="form-check form-control" /> *@
		<select id="DeptID" name="DeptID" class="form-check form-control">
			@foreach(var deptItem in Model.DeptList)
				{
					if(Model.DeptID == deptItem.Id)
					{
						<option value="@deptItem.Id" selected>@deptItem.Name</option>
					}
					else
					{
						<option value="@deptItem.Id">@deptItem.Name</option>
					}
				}
			</select>
	</div>

	<input type="submit" value="Save" class="btn btn-success"/>
</form>

@*-------------------------------------Link With Helper------------------------------------*@

<a href="/Employee/Index">Back To List</a> @*html link*@
@Html.ActionLink("Back", "Index", "Employee")

@*mix server side attr*@
<a asp-action="Index" asp-controller="Employee">Back</a>

<hr />

<a href="/Employee/Details/@Model.Id">Details</a> @*html link*@
@Html.ActionLink("--Details--", "Details", "Employee", new {@Model.Id})

@*mix server side attr*@
<a asp-action="Details" asp-controller="Employee" asp-route-id="@Model.Id">Details</a>
